# ----------------------------------------------------------------------------
# Kovio marketing site (kovio.dev) environment variables
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Set the same variables in the Vercel project for production.
# ----------------------------------------------------------------------------

# Base URL used for referral share links (https://www.kovio.dev/r/<code>).
NEXT_PUBLIC_SITE_URL=https://www.kovio.dev

# Stripe: $100 refundable Blitz deposit (Checkout Session + webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: every form emails the founders (and /api/lead's acknowledgment emails).
RESEND_API_KEY=
EMAIL_FROM="Kovio <hello@kovio.dev>"
NOTIFY_EMAILS=vivek@kovio.dev,koushik@kovio.dev

# Supabase: reservations, submissions and stripe_events tables
# (supabase/migrations). Server-only service role key; never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Number shown on /advertise.
LAUNCH_PARTNER_SLOTS_LEFT=20

# Legacy /api/lead (waitlist leads via the kovio_submit_lead RPC + creatives
# bucket). The anon key is public by design. /api/lead falls back to the
# production values when unset; set them so the credential can be rotated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional sender for /api/lead emails (defaults to notifications@kovio.dev).
RESEND_FROM=
