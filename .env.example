# ----------------------------------------------------------------------------
# Kovio marketing site (kovio.dev) environment variables
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Set the same variables in the Vercel project for production.
# ----------------------------------------------------------------------------

# Resend — sends the lead acknowledgment + internal notification emails from
# /api/lead. REQUIRED in production: without it leads still land in the
# database but no emails go out (sending is deliberately best-effort).
RESEND_API_KEY=

# Supabase project for lead storage (kovio_submit_lead RPC + creatives bucket).
# The anon key is public by design — it ships to browsers via kovio-web — so
# these are operational config, not secrets. /api/lead falls back to the
# current production values when unset, so nothing breaks before Vercel env is
# configured; set them anyway so the credential can be rotated without a code
# change and redeploy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
